# Copy to apps/api/.env and fill in. The API exits at boot if a required one is missing.

# --- required ---
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5434/portfolio?schema=public"
NODE_ENV=development
PORT=4000
ADMIN_URL=http://localhost:5180
WEB_URL=http://localhost:3010
# openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-password

# --- optional, with defaults ---
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# lax for localhost; none (with HTTPS) once the admin is on a different domain
COOKIE_SAMESITE=lax
LOG_LEVEL=info

# --- phase 4: media ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- phase 4: email ---
RESEND_API_KEY=
RESEND_FROM="Portfolio <onboarding@resend.dev>"
OWNER_EMAIL=

# --- phase 4: revalidation, must match apps/web ---
REVALIDATE_SECRET=
