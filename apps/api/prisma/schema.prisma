// Portfolio CMS schema. One admin user, eight content models, plus media,
// contact messages and refresh tokens.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  // Only the SHA-256 hash is stored, so a database leak yields no usable token.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Singleton: exactly one row, pinned to the id "singleton".
model About {
  id        String   @id @default("singleton")
  name      String
  headline  String
  bio       String
  avatarUrl String?
  resumeUrl String?
  socials   Json     @default("{}")
  location  String?
  updatedAt DateTime @updatedAt
}

model Skill {
  id        String   @id @default(cuid())
  name      String
  category  String
  level     Int      @default(3)
  icon      String?
  order     Int      @default(0)
  // Defaults to true so existing rows stay visible when this column arrives.
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

model Project {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  summary       String
  content       String
  coverImageUrl String?
  techStack     String[]
  githubUrl     String?
  liveUrl       String?
  featured      Boolean  @default(false)
  order         Int      @default(0)
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, order])
  @@index([featured, order])
}

model Blog {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String
  content       String
  coverImageUrl String?
  tags          String[]
  published     Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([published, publishedAt])
}

model Experience {
  id          String    @id @default(cuid())
  company     String
  role        String
  location    String
  startDate   DateTime
  endDate     DateTime?
  current     Boolean   @default(false)
  description String
  order       Int       @default(0)
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, order])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  company   String
  quote     String
  avatarUrl String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, order])
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
  @@index([createdAt])
}

model Media {
  id        String   @id @default(cuid())
  url       String
  publicId  String   @unique
  filename  String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
