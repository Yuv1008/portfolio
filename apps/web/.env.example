# Copy to apps/web/.env.local

# Server-side only: where the Next server fetches content from.
API_URL=http://localhost:4000

# Public: used for canonical URLs, Open Graph and the sitemap.
# The contact form posts from the browser, so this one is public.
NEXT_PUBLIC_API_URL=http://localhost:4000

NEXT_PUBLIC_SITE_URL=http://localhost:3010

# Must match REVALIDATE_SECRET in apps/api. Phase 4 and 7.
REVALIDATE_SECRET=
