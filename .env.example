# ---------------------------------------------------------------------------
# Root reference copy. Each app reads its own .env file; see apps/*/.env.example
# ---------------------------------------------------------------------------

# --- database (apps/api) ---
# Port 5434 matches docker-compose.yml so it cannot collide with a local Postgres.
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5434/portfolio?schema=public"

# --- api runtime ---
NODE_ENV=development
PORT=4000
# Comma-free single origins; CORS allows exactly these two.
ADMIN_URL=http://localhost:5180
WEB_URL=http://localhost:3010
# Refresh-cookie SameSite: lax on localhost, none in production (cross-site).
COOKIE_SAMESITE=lax

# --- auth (apps/api) ---
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- seed admin (apps/api) ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-password

# --- media, phase 4 (apps/api) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- email, phase 4 (apps/api) ---
RESEND_API_KEY=
RESEND_FROM="Portfolio <onboarding@resend.dev>"
OWNER_EMAIL=

# --- revalidation, phase 4 and 7 (apps/api + apps/web) ---
REVALIDATE_SECRET=replace-me-with-a-random-string

# --- apps/admin ---
VITE_API_URL=http://localhost:4000

# --- apps/web ---
API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3010
