# ---------------------------------------------------------------------------
# Reference copy of every variable in the project. Each app reads its own file:
#   apps/api/.env          (see apps/api/.env.example)
#   apps/admin/.env        (see apps/admin/.env.example)
#   apps/web/.env.local    (see apps/web/.env.example)
# Nothing reads this file; it exists so the whole surface is visible at once.
# ---------------------------------------------------------------------------

# --- database (apps/api) ---
# Port 5434 matches docker-compose.yml, chosen to avoid a local Postgres on 5432.
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5434/portfolio?schema=public"

# --- api runtime ---
NODE_ENV=development
PORT=4000
# CORS allows exactly these two origins, and nothing else.
ADMIN_URL=http://localhost:5180
WEB_URL=http://localhost:3010
# Refresh-cookie SameSite. `lax` on localhost; `none` in production, where the
# admin and API sit on different domains (which also forces Secure).
COOKIE_SAMESITE=lax
LOG_LEVEL=info

# --- auth (apps/api) ---
# openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- seed admin (apps/api) ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-password

# --- media (apps/api) ---
# Without these, uploads answer 503 naming the missing variables.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- email (apps/api) ---
# Resend only delivers to your own account address until a sending domain is
# verified, so start with that address as OWNER_EMAIL.
RESEND_API_KEY=
RESEND_FROM="Portfolio <onboarding@resend.dev>"
OWNER_EMAIL=

# --- revalidation (apps/api + apps/web; the two must match) ---
REVALIDATE_SECRET=replace-me-with-a-random-string

# --- apps/admin ---
# Vite inlines anything prefixed VITE_ into the bundle. Never a secret.
VITE_API_URL=http://localhost:4000

# --- apps/web ---
# Server-side only: where the Next server reads content from.
API_URL=http://localhost:4000
# Public: the contact form posts from the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public: canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3010
